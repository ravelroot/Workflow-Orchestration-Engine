digraph er {
rankdir=LR;
graph [fontname="Helvetica", bgcolor="transparent", pad="0.2", nodesep="0.35", ranksep="0.5"];
node [fontname="Helvetica", fontsize=10, color="#d6cbc5", fontcolor="#1f292f"];
edge [fontname="Helvetica", fontsize=8, color="#8a9eab", fontcolor="#65695b", arrowsize=0.7];
users [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#d6cbc5" bgcolor="#fdfbfa"><tr><td colspan="2" bgcolor="#1f292f" align="left"><font color="#ffffff" face="Courier" point-size="9"><b>users</b></font></td></tr><tr><td align="left" port="id"><font face="Courier" point-size="8">id</font></td><td align="left"><font point-size="7" color="#65695b">bigint PK</font></td></tr><tr><td align="left" port="email"><font face="Courier" point-size="8">email</font></td><td align="left"><font point-size="7" color="#65695b">varchar UK</font></td></tr><tr><td align="left" port="role"><font face="Courier" point-size="8">role</font></td><td align="left"><font point-size="7" color="#65695b">varchar</font></td></tr><tr><td align="left" port="preferences"><font face="Courier" point-size="8">preferences</font></td><td align="left"><font point-size="7" color="#65695b">json</font></td></tr></table>>];
api_tokens [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#d6cbc5" bgcolor="#fdfbfa"><tr><td colspan="2" bgcolor="#1f292f" align="left"><font color="#ffffff" face="Courier" point-size="9"><b>api_tokens</b></font></td></tr><tr><td align="left" port="id"><font face="Courier" point-size="8">id</font></td><td align="left"><font point-size="7" color="#65695b">bigint PK</font></td></tr><tr><td align="left" port="user_id"><font face="Courier" point-size="8">user_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="kind"><font face="Courier" point-size="8">kind</font></td><td align="left"><font point-size="7" color="#65695b">varchar</font></td></tr><tr><td align="left" port="token_hash"><font face="Courier" point-size="8">token_hash</font></td><td align="left"><font point-size="7" color="#65695b">char UK</font></td></tr></table>>];
audit_log [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#d6cbc5" bgcolor="#fdfbfa"><tr><td colspan="2" bgcolor="#1f292f" align="left"><font color="#ffffff" face="Courier" point-size="9"><b>audit_log</b></font></td></tr><tr><td align="left" port="id"><font face="Courier" point-size="8">id</font></td><td align="left"><font point-size="7" color="#65695b">bigint PK</font></td></tr><tr><td align="left" port="user_id"><font face="Courier" point-size="8">user_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="action"><font face="Courier" point-size="8">action</font></td><td align="left"><font point-size="7" color="#65695b">varchar</font></td></tr><tr><td align="left" port="target"><font face="Courier" point-size="8">target</font></td><td align="left"><font point-size="7" color="#65695b">varchar</font></td></tr></table>>];
workflows [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#d6cbc5" bgcolor="#fdfbfa"><tr><td colspan="2" bgcolor="#000000" align="left"><font color="#ffffff" face="Courier" point-size="9"><b>workflows</b></font></td></tr><tr><td align="left" port="id"><font face="Courier" point-size="8">id</font></td><td align="left"><font point-size="7" color="#65695b">bigint PK</font></td></tr><tr><td align="left" port="name"><font face="Courier" point-size="8">name</font></td><td align="left"><font point-size="7" color="#65695b">varchar UK</font></td></tr><tr><td align="left" port="current_version_id"><font face="Courier" point-size="8">current_version_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="params_schema"><font face="Courier" point-size="8">params_schema</font></td><td align="left"><font point-size="7" color="#65695b">json</font></td></tr><tr><td align="left" port="source_code"><font face="Courier" point-size="8">source_code</font></td><td align="left"><font point-size="7" color="#65695b">longtext</font></td></tr></table>>];
workflow_versions [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#d6cbc5" bgcolor="#fdfbfa"><tr><td colspan="2" bgcolor="#1f292f" align="left"><font color="#ffffff" face="Courier" point-size="9"><b>workflow_versions</b></font></td></tr><tr><td align="left" port="id"><font face="Courier" point-size="8">id</font></td><td align="left"><font point-size="7" color="#65695b">bigint PK</font></td></tr><tr><td align="left" port="workflow_id"><font face="Courier" point-size="8">workflow_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="version"><font face="Courier" point-size="8">version</font></td><td align="left"><font point-size="7" color="#65695b">int</font></td></tr><tr><td align="left" port="graph"><font face="Courier" point-size="8">graph</font></td><td align="left"><font point-size="7" color="#65695b">json</font></td></tr></table>>];
workflow_runs [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#d6cbc5" bgcolor="#fdfbfa"><tr><td colspan="2" bgcolor="#000000" align="left"><font color="#ffffff" face="Courier" point-size="9"><b>workflow_runs</b></font></td></tr><tr><td align="left" port="id"><font face="Courier" point-size="8">id</font></td><td align="left"><font point-size="7" color="#65695b">bigint PK</font></td></tr><tr><td align="left" port="workflow_id"><font face="Courier" point-size="8">workflow_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="version_id"><font face="Courier" point-size="8">version_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="triggered_by_id"><font face="Courier" point-size="8">triggered_by_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="status"><font face="Courier" point-size="8">status</font></td><td align="left"><font point-size="7" color="#65695b">varchar</font></td></tr><tr><td align="left" port="trigger"><font face="Courier" point-size="8">trigger</font></td><td align="left"><font point-size="7" color="#65695b">varchar</font></td></tr><tr><td align="left" port="error"><font face="Courier" point-size="8">error</font></td><td align="left"><font point-size="7" color="#65695b">longtext</font></td></tr></table>>];
task_instances [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#d6cbc5" bgcolor="#fdfbfa"><tr><td colspan="2" bgcolor="#1f292f" align="left"><font color="#ffffff" face="Courier" point-size="9"><b>task_instances</b></font></td></tr><tr><td align="left" port="id"><font face="Courier" point-size="8">id</font></td><td align="left"><font point-size="7" color="#65695b">bigint PK</font></td></tr><tr><td align="left" port="run_id"><font face="Courier" point-size="8">run_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="worker_id"><font face="Courier" point-size="8">worker_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="task_name"><font face="Courier" point-size="8">task_name</font></td><td align="left"><font point-size="7" color="#65695b">varchar</font></td></tr><tr><td align="left" port="status"><font face="Courier" point-size="8">status</font></td><td align="left"><font point-size="7" color="#65695b">varchar</font></td></tr></table>>];
task_attempts [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#d6cbc5" bgcolor="#fdfbfa"><tr><td colspan="2" bgcolor="#1f292f" align="left"><font color="#ffffff" face="Courier" point-size="9"><b>task_attempts</b></font></td></tr><tr><td align="left" port="id"><font face="Courier" point-size="8">id</font></td><td align="left"><font point-size="7" color="#65695b">bigint PK</font></td></tr><tr><td align="left" port="task_instance_id"><font face="Courier" point-size="8">task_instance_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="worker_id"><font face="Courier" point-size="8">worker_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="number"><font face="Courier" point-size="8">number</font></td><td align="left"><font point-size="7" color="#65695b">int</font></td></tr></table>>];
task_logs [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#d6cbc5" bgcolor="#fdfbfa"><tr><td colspan="2" bgcolor="#1f292f" align="left"><font color="#ffffff" face="Courier" point-size="9"><b>task_logs</b></font></td></tr><tr><td align="left" port="id"><font face="Courier" point-size="8">id</font></td><td align="left"><font point-size="7" color="#65695b">bigint PK</font></td></tr><tr><td align="left" port="attempt_id"><font face="Courier" point-size="8">attempt_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="level"><font face="Courier" point-size="8">level</font></td><td align="left"><font point-size="7" color="#65695b">varchar</font></td></tr></table>>];
workers [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#d6cbc5" bgcolor="#fdfbfa"><tr><td colspan="2" bgcolor="#1f292f" align="left"><font color="#ffffff" face="Courier" point-size="9"><b>workers</b></font></td></tr><tr><td align="left" port="id"><font face="Courier" point-size="8">id</font></td><td align="left"><font point-size="7" color="#65695b">varchar PK</font></td></tr><tr><td align="left" port="status"><font face="Courier" point-size="8">status</font></td><td align="left"><font point-size="7" color="#65695b">varchar</font></td></tr><tr><td align="left" port="concurrency"><font face="Courier" point-size="8">concurrency</font></td><td align="left"><font point-size="7" color="#65695b">int</font></td></tr></table>>];
integrations [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#d6cbc5" bgcolor="#fdfbfa"><tr><td colspan="2" bgcolor="#1f292f" align="left"><font color="#ffffff" face="Courier" point-size="9"><b>integrations</b></font></td></tr><tr><td align="left" port="id"><font face="Courier" point-size="8">id</font></td><td align="left"><font point-size="7" color="#65695b">bigint PK</font></td></tr><tr><td align="left" port="workflow_id"><font face="Courier" point-size="8">workflow_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="created_by_id"><font face="Courier" point-size="8">created_by_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="kind"><font face="Courier" point-size="8">kind</font></td><td align="left"><font point-size="7" color="#65695b">varchar</font></td></tr><tr><td align="left" port="config"><font face="Courier" point-size="8">config</font></td><td align="left"><font point-size="7" color="#65695b">json</font></td></tr></table>>];
integration_deliveries [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#d6cbc5" bgcolor="#fdfbfa"><tr><td colspan="2" bgcolor="#1f292f" align="left"><font color="#ffffff" face="Courier" point-size="9"><b>integration_deliveries</b></font></td></tr><tr><td align="left" port="id"><font face="Courier" point-size="8">id</font></td><td align="left"><font point-size="7" color="#65695b">bigint PK</font></td></tr><tr><td align="left" port="integration_id"><font face="Courier" point-size="8">integration_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="run_id"><font face="Courier" point-size="8">run_id</font></td><td align="left"><font point-size="7" color="#65695b">FK</font></td></tr><tr><td align="left" port="status"><font face="Courier" point-size="8">status</font></td><td align="left"><font point-size="7" color="#65695b">varchar</font></td></tr></table>>];
api_tokens:user_id -> users:id [label="CASCADE"];
audit_log:user_id -> users:id [label="SET NULL"];
workflow_versions:workflow_id -> workflows:id [label="CASCADE"];
workflows:current_version_id -> workflow_versions:id [label=""];
workflow_runs:workflow_id -> workflows:id [label="CASCADE"];
workflow_runs:version_id -> workflow_versions:id [label=""];
workflow_runs:triggered_by_id -> users:id [label="SET NULL"];
task_instances:run_id -> workflow_runs:id [label="CASCADE"];
task_instances:worker_id -> workers:id [label="SET NULL"];
task_attempts:task_instance_id -> task_instances:id [label="CASCADE"];
task_attempts:worker_id -> workers:id [label="SET NULL"];
task_logs:attempt_id -> task_attempts:id [label="CASCADE"];
integrations:workflow_id -> workflows:id [label="CASCADE"];
integrations:created_by_id -> users:id [label="SET NULL"];
integration_deliveries:integration_id -> integrations:id [label="CASCADE"];
integration_deliveries:run_id -> workflow_runs:id [label="CASCADE"];
}
